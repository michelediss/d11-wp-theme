/*
!/.gitignore
!/mu-plugins/
!/plugins/
!/themes/

/mu-plugins/*
!/mu-plugins/.gitkeep

/plugins/*
!/plugins/all-in-one-wp-security-and-firewall/
!/plugins/cf7-sync/
!/plugins/contact-form-7/
!/plugins/simple-cloudflare-turnstile/
!/plugins/simple-cookie-consent/
!/plugins/site-maintenance/
!/plugins/wp-statistics/
/plugins/undraw-wp/

